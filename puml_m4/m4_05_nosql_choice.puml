@startuml m4_05_nosql_choice
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Выбор хранилища по нагрузке и инвариантам
start
:Описать запросы, объём, рост,\nтранзакции и требования к актуальности;
if (Источник истины: связи и транзакции?) then (да)
 :Оценить PostgreSQL;\nJSONB для гибких атрибутов;
else (нет)
 :Сравнить документную, key-value\nи графовую модели под запросы;
endif
if (Нужен отдельный поиск или аналитика?) then (да)
 :Добавить поисковую/OLAP read-модель;\nисточник истины сохранить явно;
 :Указать доставку изменений, lag,\nдедупликацию и восстановление;
endif
:Проверить кандидатов на данных и нагрузке;\nзафиксировать стоимость и решение в ADR;
stop
@enduml
