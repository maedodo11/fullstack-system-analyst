@startuml m4_03_isolation_anomaly
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
title Аномалия Lost Update при Read Committed (два кассира, счёт 100 ₽)

participant "Транзакция A\n(кассир 1)" as TA
participant "Баланс счёта" as BAL
participant "Транзакция B\n(кассир 2)" as TB

TA -> BAL : BEGIN; SELECT balance -> читаем 100
BAL --> TA : 100
TB -> BAL : BEGIN; SELECT balance -> читаем 100
BAL --> TB : 100
TA -> BAL : UPDATE SET balance = 100 - 70 = 30; COMMIT
note over BAL : баланс = 30
TB -> BAL : UPDATE SET balance = 100 - 50 = 50; COMMIT
note over BAL #F8CECC : Ожидание: 100 - 70 - 50 = -20\nФакт: 50\nСписание кассира B потеряно:\nобе транзакции читали 100\nдо фиксации другой
@enduml
