@startuml m4_02_index_explain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Индексы и EXPLAIN: разбор медленного запроса (10M строк)

card "Запрос:\nSELECT * FROM users\nWHERE email = 'a@b.co';\nВремя: 4 с" as Q #F8CECC
card "EXPLAIN ANALYZE\n-> Seq Scan on users\n   rows=9981234 filtered=1\n   cost=0..218741\nНет индекса — читается вся таблица" as E1 #FFF2CC
card "Лечение:\nCREATE INDEX CONCURRENTLY\n  idx_users_email ON users(email);\nB-tree: равенство и диапазоны,\nNOT NULL уникальность по бизнесу" as F #DAE8FC
card "Контроль:\nEXPLAIN -> Index Scan using idx_users_email\nrows=1, время 4 с -> 3 мс\nCONCURRENTLY — не блокирует обычные writes;\nDDL-блокировки и ожидания возможны" as V #D5E8D4
Q --> E1 : диагноз
E1 --> F : план
F --> V : проверка
card "Составной индекс (status, created_at):\nработает по ЛЕВОМУ префиксу\nWHERE status=? AND created_at>? — ок\nWHERE created_at>? — зависит от плана\nПравило: колонка фильтра равенства — первой" as CP #E1D5E7
V ..> CP : вывод
@enduml
