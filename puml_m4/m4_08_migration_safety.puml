@startuml m4_08_migration_safety
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Expand-Contract миграция схемы: безопасный путь против DROP COLUMN в один деплой

|Expand|
start
:V1: ADD COLUMN status_new text NULL;\n(без переписывания строк; учитывать DDL lock);
:V2: dual-write: код пишет status и status_new;
:V3: бэкфилл пачками по 10k\n(LIMIT-цикл, чтобы не держать long tx);
:V4: переключить чтение на status_new;\nнаблюдать метрики;
|Contract|
:V5: остановить write в status (старый код выведен);\nALTER ... DROP COLUMN status — отдельным релизом;
stop
note right
Антипаттерн слева внизу:
DROP COLUMN в том же деплое, что код
=> старые поды (rolling update) падают
на отсутствующую колонку.
Правило: миграция совместима с N и N+1
версиями кода; Flyway/Liquibase,
порядок версий неизменен.
end note
@enduml
