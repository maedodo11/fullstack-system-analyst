@startuml 01_requirements_pyramid
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
skinparam rectangle {
  RoundCorner 12
}
title Уровни требований: от бизнеса к коду

rectangle "**Бизнес-требования (BR)**\nЗАЧЕМ? Конверсия корзины 2% -> 5%" as BR #FFE9A8
rectangle "**Пользовательские (UR)**\nUser Story: оформить заказ в 3 клика" as UR #FFD6A5
rectangle "**Функциональные (FR)**\nСистема рассчитывает скидку активного промокода" as FR #BDE3C4
rectangle "**Нефункциональные (NFR)**\np95 checkout <= 500 мс при 1000 RPS\nметод и стенд измерения согласованы" as NFR #A8D5F2
rectangle "**Тесты и код**\nGherkin AC -> автотест -> реализация" as T #D8C7F0

BR -down-> UR : декомпозиция
UR -down-> FR : спецификация
FR -right-> NFR : качество выполнения
FR -down-> T : проверка поведения
NFR -down-> T : проверка качества
note bottom of T : Трассировка связывает цель, требования и проверки по ID.
@enduml
