@startuml 02_api_integration_styles
!pragma layout smetana
!theme plain
skinparam backgroundColor #FEFEFE
title Выбор стиля интеграции

left to right direction
rectangle "Клиент\n(web/mobile)" as C
rectangle "API Gateway\nREST/JSON + OpenAPI,\nrate limit, JWT" as GW
rectangle "Сервисы\ngRPC (HTTP/2, protobuf)" as S1
rectangle "Брокер событий\nKafka: OrderCreated.v2" as K
rectangle "Внешний провайдер\nWebhook + HMAC подпись" as W

C --> GW : HTTPS
GW --> S1 : синхронно, таймаут+ретраи
S1 --> K : асинхронно, outbox
K --> S1 : события, DLQ при ошибках
W --> GW : callback (идемпотентность!)
note bottom of GW
  Правило: синхронно — когда нужен ответ клиенту;
  асинхронно — когда можно 202 Accepted + статус позже
end note
@enduml
