@startuml 06_circuit_breaker
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Circuit Breaker: три состояния

state "CLOSED\n(замкнут, трафик идёт)" as CLOSED #C8E6C9
state "OPEN\n(разомкнут, fail-fast)" as OPEN #FFCDD2
state "HALF-OPEN\n(пробные запросы)" as HALF #FFE082

CLOSED --> OPEN : failures > threshold\n(напр. 50% за 10 с)
OPEN --> HALF : после cooldown\n(таймаут открытой фазы)
HALF --> CLOSED : probe requests OK
HALF --> OPEN : probe failed

note right of OPEN
  OPEN: сразу возвращать ошибку/fallback,
  не дергая умирающий сервис —
  даёт ему время восстановиться.
end note
@enduml
