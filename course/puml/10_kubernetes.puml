@startuml 10_kubernetes
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Деплой микросервисов в Kubernetes

node "K8s Cluster" as K8S #ECEFF1 {
  node "Worker Node 1" as N1 #E3F2FD {
    rectangle "Pod: orders x3\n(container + sidecar)" as P1 #4FC3F7
    rectangle "Pod: users x2" as P2 #81C784
  }
  node "Worker Node 2" as N2 #E3F2FD {
    rectangle "Pod: orders x3\n(другие инстансы)" as P3 #4FC3F7
    rectangle "Pod: payments x2" as P4 #FFB74D
  }
}

rectangle "Deployment\n(replicas, rolling update,\nmaxUnavailable)" as DEP #BA68C8
rectangle "Service (ClusterIP)\n+ Ingress / LB" as SVC #FFE082
database "ConfigMap / Secret" as CFG #B0BEC5

DEP -right-> P1 : управляет
DEP -right-> P3
SVC -down-> P1 : load balancing\nпо readiness
SVC -down-> P2
SVC -down-> P4
CFG ..> P1 : env / конфиг

note bottom of SVC
  Liveness restart контейнер,
  readiness убирает из балансировки.
  HPA масштабирует Deployment по CPU/RPS.
end note
@enduml
