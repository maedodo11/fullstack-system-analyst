@startuml 05_saga_orchestration
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Saga оплаты: отказ и неизвестный результат различаются
state "Заказ создан" as C
state "Товар зарезервирован" as R
state "Оплата выполняется" as P
state "Сверка результата\nUNKNOWN / PAYMENT_RECONCILING" as U
state "Заказ оплачен" as S
state "Снять резерв\nпри подтверждённом отказе" as F
state "Ручной разбор\nс журналом и алертом" as M
[*] --> C
C --> R
R --> P
P --> S : подтверждённый успех
P --> F : подтверждённый отказ
P --> U : timeout
U --> S : сверка / webhook: успех
U --> F : сверка: отказ
U --> M : превышен срок сверки
S --> [*]
F --> [*]
note bottom of U
Не запускаем новый charge с новым ключом.
Компенсация — отдельное бизнес-действие, не rollback.
Поздний успех после отмены требует контролируемого refund.
end note
@enduml
