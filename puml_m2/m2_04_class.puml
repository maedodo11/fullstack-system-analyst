@startuml m2_04_class
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Class-диаграмма предметной области: snapshot цены и связующий класс
class Врач {
  -id
  -ФИО
  +публикуетСлоты()
}
class Слот {
  -id
  -датаВремя
  -длительность
  +занять()
}
class Запись {
  -id
  -статус
  +отменить()
  +подтвердить()
}
class Пациент {
  -id
  -ФИО
  -телефон
}
class ПозицияУслуги {
  -названиеSnapshot
  -ценаSnapshot
  -дата
}
class Услуга {
  -id
  -актуальнаяЦена
  +изменитьЦену()
}
Врач "1" -- "0..*" Слот : расписание
Пациент "1" -- "0..*" Запись : делает
Слот "1" -- "0..1" Запись : бронирует
Запись "1" *-- "1..*" ПозицияУслуги : содержит (композиция)
Услуга "1" .u.> "0..*" ПозицияУслуги : копия цены на момент покупки
note bottom of ПозицияУслуги : Цена хранится СНАПШОТОМ, а не ссылкой\nна Услугу: иначе ретроспектива чеков «плывёт»
@enduml
