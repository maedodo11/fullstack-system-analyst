@startuml m2_05_er
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title ER: M:N «запись ↔ услуга» через связующую таблицу + кардинальности
entity Пациент {
  * patient_id <<UUID>>
  --
  fio
  phone
}
entity Запись {
  * booking_id <<UUID>>
  --
  * patient_id <<FK>>
  * slot_id <<FK>>
  status
}
entity Услуга {
  * service_id <<UUID>>
  --
  name
  price_current
}
entity ЗаписьУслуга {
  * booking_id <<FK>>
  * service_id <<FK>>
  --
  price_snapshot
  qty
}
Пациент ||--|{ Запись : «1 — 1..*»
Запись ||--|{ ЗаписьУслуга : дробит на позиции
Услуга ||--|{ ЗаписьУслуга : «M:N разрешён»
note bottom of ЗаписьУслуга : Без этой таблицы схема была бы\n«Запись.services UUID[]» — без индексов\nи целостности
@enduml
