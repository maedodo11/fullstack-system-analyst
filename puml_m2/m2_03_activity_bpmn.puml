@startuml m2_03_activity_bpmn
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Activity/BPMN: возврат средств за отменённый визит (дорожки + шлюзы + события)
|#LightBlue|Пациент|
start
:Запрашивает возврат;
|#PaleGreen|Система записи|
if (Визит был оплачен?) then (нет)
  :Отказать (409);
  kill
else (да)
  if (Срок возврата ≤ 14 дней?) then (да)
    :Создать RefundRequest;
  else (нет)
    #LightYellow:Регистратура: ручное решение\n(таймер-событие: эскалация через 3 дня);
    note right
      В BPMN это промежуточное
      таймер-событие на задаче
      + boundary timer
    end note
    if (Одобрено?) then (да)
      :Создать RefundRequest;
    else (нет)
      stop
    endif
  endif
endif
|#Lavender|Банк|
:Провести возврат на карту;
stop
@enduml
