@startuml ex05_nfr_iso
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Учебные категории качества и примеры метрик для API сервиса записи
rectangle "Performance efficiency:\nP95 <= 300 мс, 500 RPS на стенде perf" as PE #LightBlue
rectangle "Reliability:\nSLA 99.9%/мес, RTO 4 ч, RPO 15 мин" as RE #LightGreen
rectangle "Security:\nOWASP Top-10, шифрование PII at rest" as SE #Salmon
rectangle "Usability:\nзапись <= 3 шага, WCAG 2.1 AA" as US #Plum
rectangle "Maintainability:\nкритичные сценарии проверены;\nвремя диагностики и ремонта измеряется" as MA #LightYellow
PE -right- RE
RE -right- SE
SE -down- US
US -left- MA
@enduml
