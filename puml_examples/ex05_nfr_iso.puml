@startuml ex05_nfr_iso
!pragma layout smetana
title Классы NFR по ISO/IEC 25010 и типовые метрики для API сервиса записи
skinparam defaultFontName "DejaVu Sans"
rectangle "Performance efficiency:\nP95 <= 300 мс, 500 RPS на стенде perf" as PE #LightBlue
rectangle "Reliability:\nSLA 99.9%/мес, RTO 4 ч, RPO 15 мин" as RE #LightGreen
rectangle "Security:\nOWASP Top-10, шифрование PII at rest" as SE #Salmon
rectangle "Usability:\nзапись <= 3 шага, WCAG 2.1 AA" as US #Plum
rectangle "Maintainability:\ne2e покрытие >= 80%, MTTR <= 30 мин" as MA #LightYellow
PE -right- RE
RE -right- SE
SE -down- US
US -left- MA
@enduml
