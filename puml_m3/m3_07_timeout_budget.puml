@startuml m3_07_timeout_budget
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam dpi 140
title Сквозной deadline: вложенные ожидания не складываются автоматически
rectangle "Клиент\nобщий бюджет 2000 мс" as C
rectangle "Gateway\nоставляет запас на сеть и ответ" as G
rectangle "Service A\nполучает оставшийся бюджет\nрезервирует свою работу" as A
rectangle "Service B\nвыполняет вызов в остатке бюджета" as B
C --> G : запрос + deadline
G --> A : остаток ≤1700 мс
A --> B : остаток ≤1200 мс
note bottom of A
Retry + backoff тоже расходуют общий бюджет.
Таймаут клиента не отменяет уже выполненный бизнес-эффект.
Числа иллюстративны; измеряем весь путь.
end note
@enduml
